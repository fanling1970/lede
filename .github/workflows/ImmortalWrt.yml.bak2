# ImmortalWrt 编译工作流 | CCACHE加速版 | 修复toolchain误删 & rust依赖 & libtool报错 | 中文步骤名
# 基于 P3TERX Actions-OpenWrt 改造

name: immortalwrt

on:
  workflow_dispatch:

env:
  REPO_URL: https://github.com/VIKINGYFY/immortalwrt.git
  REPO_BRANCH: main
  FEEDS_CONF: immortalwrt/feeds.conf.default
  CONFIG_FILE: immortalwrt/info.config
  DIY_P1_SH: immortalwrt/diy-part1.sh
  DIY_P2_SH: immortalwrt/diy-part2.sh
  UPLOAD_BIN_DIR: false
  UPLOAD_FIRMWARE: true
  UPLOAD_RELEASE: true
  TZ: Asia/Shanghai
  # CCACHE 缓存配置
  CCACHE_DIR: /home/runner/.ccache
  CCACHE_COMPRESS: 1
  CCACHE_COMPRESSLEVEL: 6

jobs:
  build:
    runs-on: ubuntu-22.04
    steps:
      - name: 检出代码
        uses: actions/checkout@v4

      - name: 初始化编译环境
        timeout-minutes: 15
        env:
          DEBIAN_FRONTEND: noninteractive
        run: |
          sudo tee /etc/apt/sources.list << 'EOF'
          deb http://mirrors.aliyun.com/ubuntu/ jammy main restricted universe multiverse
          deb http://mirrors.aliyun.com/ubuntu/ jammy-security main restricted universe multiverse
          deb http://mirrors.aliyun.com/ubuntu/ jammy-updates main restricted universe multiverse
          deb http://mirrors.aliyun.com/ubuntu/ jammy-backports main restricted universe multiverse
          EOF
          sudo rm -rf /var/lib/apt/lists/* && sudo apt-get clean
          sudo apt-get update -qq
          sudo apt-get install -qq \
            build-essential ccache curl g++ gawk gettext git \
            libncurses5-dev libssl-dev python3 python3-distutils \
            python3-setuptools rsync unzip wget zlib1g-dev autoconf \
            automake bison flex gcc-multilib g++-multilib libelf-dev \
            libtool make pkg-config subversion texinfo help2man m4
          sudo timedatectl set-timezone "$TZ"
          sudo mkdir -p /workdir && sudo chown $USER:$GROUPS /workdir

      - name: 恢复CCACHE编译缓存
        uses: actions/cache@v4
        with:
          path: ${{ env.CCACHE_DIR }}
          key: ccache-${{ runner.os }}-${{ env.REPO_BRANCH }}-${{ github.sha }}
          restore-keys: |
            ccache-${{ runner.os }}-${{ env.REPO_BRANCH }}-

      - name: 克隆源码
        run: git clone --depth=1 $REPO_URL -b $REPO_BRANCH openwrt

      - name: 清理编译残留缓存
        run: |
          cd openwrt
          # 仅删除编译生成的临时目录，严禁删除源码原生目录(toolchain/package/tools等)
          rm -rf build_dir staging_dir tmp .config *.oldconfig
          ./scripts/feeds clean

      - name: 执行自定义脚本Part1
        run: |
          [ -e $FEEDS_CONF ] && cp $FEEDS_CONF openwrt/feeds.conf.default
          chmod +x $GITHUB_WORKSPACE/$DIY_P1_SH
          cd openwrt && $GITHUB_WORKSPACE/$DIY_P1_SH

      - name: 更新软件源
        run: cd openwrt && ./scripts/feeds update -a -q

      - name: 安装软件包
        run: cd openwrt && ./scripts/feeds install -a -q

      - name: 执行自定义脚本Part2
        run: |
          [ -e files ] && cp -r files openwrt/files
          chmod +x $GITHUB_WORKSPACE/$DIY_P2_SH
          cd openwrt && $GITHUB_WORKSPACE/$DIY_P2_SH

      - name: 修复Rust宿主依赖缺失
        run: |
          cd openwrt
          # 强制安装rust相关包，解决rust/host不存在警告
          ./scripts/feeds install -a -f rust rust-host cargo
          # 若源码自带rust包则刷新符号链接
          if [ -d package/devel/rust ]; then
            ln -sf ../../../package/devel/rust package/feeds/packages/rust 2>/dev/null || true
          fi

      - name: 加载配置并启用CCACHE
        run: |
          cd openwrt
          if [ -e $GITHUB_WORKSPACE/$CONFIG_FILE ]; then
            cp $GITHUB_WORKSPACE/$CONFIG_FILE .config
          else
            make defconfig
          fi
          # 强制开启CCACHE编译加速
          sed -i '/CONFIG_CCACHE/d' .config
          echo "CONFIG_CCACHE=y" >> .config
          # 设置缓存最大容量
          ccache -M 10G -z

      - name: 生成默认配置
        run: |
          cd openwrt
          make defconfig || {
            echo "❌ make defconfig 失败，请检查配置文件是否有冲突"
            exit 1
          }

      - name: 下载依赖源码包（失败自动重试）
        run: |
          cd openwrt
          mkdir -p dl
          
          # 第1次并发下载
          make download -j8 || true
          find dl -size -1024c -print -delete
          
          # 第2次单线程兜底重试
          make download -j1 || true
          find dl -size -1024c -print -delete
          
          # 第3次最终重试
          make download -j1 || true
          
          # 最终校验
          BAD_FILES=$(find dl -size -1024c)
          if [ -n "$BAD_FILES" ]; then
            echo "❌ 以下源码包下载失败："
            echo "$BAD_FILES"
            exit 1
          fi
          
          echo "✅ 全部依赖包下载完成"

      - name: 编译宿主工具链（修复libtool报错）
        run: cd openwrt && make -j1 host/install V=0

      - name: 全速编译固件
        id: compile
        run: |
          cd openwrt
          make -j$(nproc) V=0
          echo "status=success" >> $GITHUB_OUTPUT
          grep '^CONFIG_TARGET.*DEVICE.*=y' .config | sed -r 's/.*DEVICE_(.*)=y/\1/' > DEVICE_NAME
          [ -s DEVICE_NAME ] && echo "DEVICE_NAME=_$(cat DEVICE_NAME)" >> $GITHUB_ENV
          echo "FILE_DATE=_$(date +"%Y%m%d%H%M")" >> $GITHUB_ENV

      - name: 显示CCACHE缓存统计
        run: ccache -s

      - name: 整理固件文件
        id: organize
        if: env.UPLOAD_FIRMWARE == 'true' && !cancelled()
        run: |
          cd openwrt/bin/targets/*/*
          rm -rf packages
          echo "FIRMWARE_PATH=$(pwd)" >> $GITHUB_ENV
          echo "status=success" >> $GITHUB_OUTPUT

      - name: 上传固件产物
        uses: actions/upload-artifact@v4
        if: steps.organize.outputs.status == 'success' && !cancelled()
        with:
          name: OpenWrt_firmware$$
          path: ${{ env.FIRMWARE_PATH }}

      - name: 生成发布标签
        id: tag
        if: env.UPLOAD_RELEASE == 'true' && !cancelled()
        run: |
          echo "release_tag=$(date +"%Y.%m.%d-%H%M")" >> $GITHUB_OUTPUT
          touch release.txt
          echo "status=success" >> $GITHUB_OUTPUT

      - name: 发布固件到Release
        uses: softprops/action-gh-release@master
        if: steps.tag.outputs.status == 'success' && !cancelled()
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        with:
          tag_name: ${{ steps.tag.outputs.release_tag }}
          body_path: release.txt
          files: ${{ env.FIRMWARE_PATH }}/*

      - name: 清理旧工作流记录
        uses: Mattraks/delete-workflow-runs@main
        with:
          retain_days: 0
          keep_minimum_runs: 2

      - name: 清理旧发布版本
        uses: dev-drprasad/delete-older-releases@master
        if: env.UPLOAD_RELEASE == 'true' && !cancelled()
        with:
          keep_latest: 3
          delete_tags: true
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
