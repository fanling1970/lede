# ======================================
# ① 目标平台（必须锁死，防止默认配置变更）
# ======================================
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y

# ======================================
# ② 三频无线（手动加，默认配置不开QCN9074第三频）
# ======================================
# 第三频QCN9074固件（必须加，否则5G-2消失）
CONFIG_PACKAGE_ath11k-firmware-qcn9074=y
# QCN9074走PCIe总线，必须加
CONFIG_PACKAGE_kmod-ath11k-pci=y
# IPQ6018内置双频（默认已开，但手动锁死更安全）
CONFIG_PACKAGE_ath11k-firmware-ipq6018=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
# 无线基础配置（默认已开，手动锁死）
CONFIG_ATH_USER_REGD=y
CONFIG_ATH11K_THERMAL=y
CONFIG_PACKAGE_wpad-openssl=y

# ======================================
# ③ NSS硬件加速 + Turbo ACC（手动加，默认只开基础NSS）
# ======================================
# NSS核心驱动（默认已开，手动锁死）
CONFIG_PACKAGE_nss-firmware-ipq6018=y
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-ssdk=y
# Turbo ACC用户态插件+内核模块（默认不开，必须加）
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_kmod-fast-classifier=m
CONFIG_PACKAGE_kmod-shortcut-fe=y
CONFIG_PACKAGE_kmod-shortcut-fe-cm=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_BBR_CCA=y

# ======================================
# ④ 你导出的Docker配置（完全保留，只砍冗余）
# ======================================
CONFIG_CGROUPFS_MOUNT_KERNEL_CGROUPS=y
CONFIG_DOCKER_CGROUP_OPTIONS=y
CONFIG_DOCKER_NET_MACVLAN=y
CONFIG_DOCKER_OPTIONAL_FEATURES=y
CONFIG_DOCKER_STO_EXT4=y
# 以下Docker相关项全部保留你导出的内容
CONFIG_KERNEL_ARM_PMU=y
CONFIG_KERNEL_CFQ_GROUP_IOSCHED=y
CONFIG_KERNEL_CGROUP_DEVICE=y
CONFIG_KERNEL_CGROUP_FREEZER=y
CONFIG_KERNEL_CGROUP_HUGETLB=y
CONFIG_KERNEL_CGROUP_NET_PRIO=y
CONFIG_KERNEL_CGROUP_PERF=y
CONFIG_KERNEL_HUGETLBFS=y
CONFIG_KERNEL_HUGETLB_PAGE=y
CONFIG_KERNEL_MEMCG_SWAP_ENABLED=y
CONFIG_KERNEL_NET_CLS_CGROUP=y
CONFIG_KERNEL_PERF_EVENTS=y
CONFIG_KERNEL_TRANSPARENT_HUGEPAGE=y
CONFIG_KERNEL_TRANSPARENT_HUGEPAGE_ALWAYS=y
CONFIG_PACKAGE_avahi-dbus-daemon=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_cgroupfs-mount=y
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_dbus=y
CONFIG_PACKAGE_dockerd=y
# 可选：docker-compose占空间，不用可以删
# CONFIG_PACKAGE_docker-compose is not set
CONFIG_PACKAGE_kmod-crypto-acompress=y
CONFIG_PACKAGE_kmod-crypto-blake2b=y
CONFIG_PACKAGE_kmod-crypto-xxhash=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-lib-crc32c=y
CONFIG_PACKAGE_kmod-lib-lzo=y
CONFIG_PACKAGE_kmod-lib-raid6=y
CONFIG_PACKAGE_kmod-lib-xor=y
CONFIG_PACKAGE_kmod-lib-xxhash=y
CONFIG_PACKAGE_kmod-lib-zlib-deflate=y
CONFIG_PACKAGE_kmod-lib-zlib-inflate=y
CONFIG_PACKAGE_kmod-lib-zstd=y
CONFIG_PACKAGE_kmod-nf-ipvs=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_libattr=y
CONFIG_PACKAGE_libavahi-dbus-support=y
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libdaemon=y
CONFIG_PACKAGE_libdbus=y
CONFIG_PACKAGE_libexpat=y
CONFIG_PACKAGE_liblzo=y
CONFIG_PACKAGE_libmount=y
CONFIG_PACKAGE_libseccomp=y
CONFIG_PACKAGE_libuv=y
CONFIG_PACKAGE_libwebsockets-full=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_runc=y
CONFIG_PACKAGE_tini=y
CONFIG_PACKAGE_wsdd2=y
# ttyd网页终端不用可以删
# CONFIG_PACKAGE_ttyd is not set
CONFIG_PACKAGE_ucode-mod-socket=y

# ======================================
# ⑤ Argon主题（手动加，默认是bootstrap主题）
# ======================================
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# ======================================
# SSR Plus 全量协议支持（所有格式全覆盖）
# ======================================
# 基础界面（你原有的）
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-i18n-ssr-plus-zh-cn=y

# ---------- SSR 协议核心（你原有的，保留） ----------
CONFIG_PACKAGE_shadowsocksr-libev-ssr-server=y
CONFIG_PACKAGE_shadowsocksr-libev-ssr-local=y
CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir=y

# ---------- Shadowsocks 协议（新版 Rust 实现，性能更好） ----------
CONFIG_PACKAGE_shadowsocks-rust-sslocal=y
CONFIG_PACKAGE_shadowsocks-rust-ssserver=y
CONFIG_PACKAGE_shadowsocks-rust-ssmanager=y

# ---------- V2Ray / Xray 协议（支持 Vmess/VLESS/Trojan 等） ----------
CONFIG_PACKAGE_v2ray-core=y          # V2Ray 核心，支持 Vmess/VLESS/Shadowsocks
CONFIG_PACKAGE_xray-core=y           # Xray 核心，支持 XTLS/Reality 等新特性
CONFIG_PACKAGE_v2ray-geodata=y       # 地理数据（国内/国外分流用）
CONFIG_PACKAGE_v2dat=y               # Geo 数据处理工具

# ---------- Trojan 系列协议 ----------
CONFIG_PACKAGE_trojan=y              # 经典 Trojan 协议
CONFIG_PACKAGE_trojan-plus=y          # Trojan-Plus 增强版
CONFIG_PACKAGE_trojan-go=y            # Trojan-Go（支持 WS/GRPC 伪装）

# ---------- 新协议支持 ----------
CONFIG_PACKAGE_naiveproxy=y           # NaiveProxy（抗封锁能力强）
CONFIG_PACKAGE_hysteria=y             # Hysteria/Hysteria2（弱网环境速度快）

# ---------- 辅助工具（透明代理/DNS 分流必需） ----------
CONFIG_PACKAGE_ipt2socks=y            # 把 iptables 流量转成 SOCKS5（透明代理核心）
CONFIG_PACKAGE_dns2socks=y            # DNS 请求转 SOCKS5（防 DNS 污染）
CONFIG_PACKAGE_geoview=y              # Geo 数据查看工具（后台可看分流规则）
CONFIG_PACKAGE_simple-obfs=y          # 流量混淆（兼容老节点）
CONFIG_PACKAGE_obfs4=y                # obfs4 混淆（抗深度包检测）
# 砍冗余代理插件（和SSR重复）
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-openclash is not set

# ======================================
# ⑦ KSMBD文件共享（手动加，默认是Samba4）
# ======================================
CONFIG_PACKAGE_autosamba_INCLUDE_KSMBD=y
# 砍默认Samba4（冲突）
# CONFIG_PACKAGE_samba4-server is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set

# ======================================
# ⑧ iStore生态 + Athena LED（手动加）
# ======================================
CONFIG_PACKAGE_luci-app-athena-led=y
CONFIG_PACKAGE_luci-i18n-athena-led-zh-cn=y
CONFIG_PACKAGE_luci-app-linkease=y
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_luci-app-store=y

# CONFIG_PACKAGE_luci-app-openclash=n

# CONFIG_PACKAGE_luci-app-passwall=n
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy=n
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=n
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server=n
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=n
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=n
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geoview=n
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=n
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=n

# ======================================
# ⑨ 内核调试裁剪（你手动改的，diffconfig已导出，保留）
# ======================================
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_KALLSYMS is not set

# ======================================
# ⑩ LuCI基础配置（手动加，确保中文界面）
# ======================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
